CALCU_OPS_ANALYST_USER=analista_operaciones
CALCU_OPS_ANALYST_PASSWORD=tu_contraseña_segura_analista_ops

CALCU_COM_USER=comercial
CALCU_COM_PASSWORD=tu_contraseña_segura_comercial

CALCU_COM_ANALYST_USER=analista_comercial
CALCU_COM_ANALYST_PASSWORD=tu_contraseña_segura_analista_com

CALCU_3PL_ADMIN_USER=admin_3pl
CALCU_3PL_ADMIN_PASSWORD=tu_contraseña_segura_admin_3pl

CALCU_3PL_OPERARIO_USER=operario_3pl
CALCU_3PL_OPERARIO_PASSWORD=tu_contraseña_segura_operario_3pl

CALCU_3PL_CHOFER_USER=conductor_3pl
