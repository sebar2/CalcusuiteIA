CALCU_ADMIN_PASSWORD=tu_contraseña_segura_admin

CALCU_CONTROLLER_USER=controller_admin
CALCU_CONTROLLER_PASSWORD=tu_contraseña_segura_controller

CALCU_OPS_USER=operaciones
