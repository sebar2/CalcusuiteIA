# 1. Integraciones Comerciales (Mercado Libre OAuth 2.0)
# Requiere credenciales registradas en developers.mercadolibre.com
MELI_CLIENT_ID=tu_meli_client_id_aqui
MELI_CLIENT_SECRET=tu_meli_client_secret_aqui

# 2. Búsqueda y Benchmarking Web (Serper.dev)
SERPER_API_KEY=tu_serper_api_key_aqui

# 3. Motor de Inferencia Local (Ollama & OpenAI-compatible)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_TIMEOUT=300

# 4. Ciberseguridad y Autenticación RBAC (JWT Bearer Tokens)
JWT_SECRET_KEY=cambiar_por_clave_secreta_criptografica_minimo_32_caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 5. Base de Datos Relacional (PostgreSQL 16 en Producción / Docker)
DATABASE_URL=postgresql+pg8000://calcu_user:calcu_secure_pass_2026@localhost:5432/calcu_db

# 6. Uruguay Procurement API (Con la Tuya / SICE / ARCE)
CONLATUYA_API_KEY=tu_api_key_aqui
CONLATUYA_BASE_URL=https://conlatuya.checkleaked.cc/api

# 7. Credenciales Corporativas Autorizadas (Modificar en tu .env local)
